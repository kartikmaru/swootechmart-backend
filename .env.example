# ─────────────────────────────────────────────────────────────────────────────
# SwooTechMart Backend — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development            # 'production' on Render
PORT=5000                       # Render sets this automatically

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>

# ── JWT secret ────────────────────────────────────────────────────────────────
SECRET_KEY=your_very_long_random_jwt_secret_here

# ── Frontend URLs (CORS whitelist) ───────────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL_ALT=                   # optional second URL
BACKEND_URL=https://your-backend.onrender.com

# ── Brevo (transactional email) ───────────────────────────────────────────────
# Steps:
#   1. Sign up at app.brevo.com (free — 300 emails/day, any recipient)
#   2. Go to: SMTP & API → API Keys → Generate a new API Key
#   3. Copy the key and paste below
#   4. Go to: Senders & IPs → Senders → Add a sender email
#      (use your gmail or any email you own — Brevo will send a confirmation)
#   5. Click the confirmation link in your email
#   6. On Render, set BREVO_API_KEY and SENDER_EMAIL env vars
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDER_EMAIL=your-verified-sender@gmail.com
OWNER_EMAIL=you@gmail.com           # receives contact form submissions

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_API=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── Legacy (not used — kept for reference) ───────────────────────────────────
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password
